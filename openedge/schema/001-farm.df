
ADD TABLE "Farm"
  AREA "Schema Area"
  DESCRIPTION "A farm owned or managed by a farmer"
  DUMP-NAME "farm"

ADD FIELD "FarmId" OF "Farm" AS integer
  FORMAT ">>>>9"
  INITIAL "0"
  LABEL "Farm Id"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10
  MANDATORY

ADD FIELD "FarmName" OF "Farm" AS character
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Farm Name"
  POSITION 3
  MAX-WIDTH 80
  ORDER 20
  MANDATORY

ADD FIELD "Location" OF "Farm" AS character
  FORMAT "x(60)"
  INITIAL ""
  LABEL "Location"
  POSITION 4
  MAX-WIDTH 120
  ORDER 30

ADD FIELD "Acreage" OF "Farm" AS decimal
  FORMAT ">>,>>9.99"
  INITIAL "0"
  LABEL "Acreage"
  POSITION 5
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 40

ADD INDEX "FarmId" ON "Farm"
  AREA "Schema Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "FarmId" ASCENDING

.
PSC
cpstream=ISO8859-1
.
0000001040
