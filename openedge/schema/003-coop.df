  LABEL "Contract Id"
  POSITION 4
  MAX-WIDTH 4
  ORDER 30
  MANDATORY

ADD FIELD "Kg" OF "Allocation" AS integer
  FORMAT ">>>>>>>>9"
  INITIAL "0"
  LABEL "Quantity (kg)"
  POSITION 5
  MAX-WIDTH 4
  ORDER 40
  MANDATORY

ADD FIELD "PricePerKg" OF "Allocation" AS decimal
  FORMAT "->>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Price per kg (R)"
  POSITION 6
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 50
  MANDATORY

ADD FIELD "AllocStatus" OF "Allocation" AS character
  FORMAT "x(20)"
  INITIAL ""
