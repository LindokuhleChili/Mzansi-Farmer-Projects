ADD INDEX "ContractAlloc" ON "Allocation"
  AREA "Schema Area"
  INDEX-FIELD "ContractId" ASCENDING
  INDEX-FIELD "AllocStatus" ASCENDING

ADD TABLE "Payout"
  AREA "Schema Area"
  DESCRIPTION "A payout to a member for their share of a harvest lot, after credit is deducted. Needs the farmer approval step. Example data only"
  DUMP-NAME "payout"

ADD FIELD "PayoutId" OF "Payout" AS integer
  FORMAT ">>>>>>>>9"
  INITIAL "0"
  LABEL "Payout Id"
  POSITION 2
  MAX-WIDTH 4
  ORDER 10
  MANDATORY

ADD FIELD "LotId" OF "Payout" AS integer
  FORMAT ">>>>>>>>9"
  INITIAL "0"
  LABEL "Lot Id"
  POSITION 3
  MAX-WIDTH 4
  ORDER 20
  MANDATORY

ADD FIELD "MemberId" OF "Payout" AS integer
  FORMAT ">>>>>>>>9"
  INITIAL "0"
  LABEL "Member Id"
  POSITION 4
  MAX-WIDTH 4
  ORDER 30
  MANDATORY

ADD FIELD "GrossAmount" OF "Payout" AS decimal
  FORMAT "->>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Gross (R)"
  POSITION 5
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 40
  MANDATORY

ADD FIELD "CreditDeducted" OF "Payout" AS decimal
  FORMAT "->>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Credit deducted (R)"
  POSITION 6
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 50

ADD FIELD "NetAmount" OF "Payout" AS decimal
  FORMAT "->>>,>>>,>>9.99"
  INITIAL "0"
  LABEL "Net (R)"
  POSITION 7
  MAX-WIDTH 17
  DECIMALS 2
  ORDER 60
  MANDATORY

ADD FIELD "PayoutStatus" OF "Payout" AS character
  FORMAT "x(20)"
  INITIAL ""
  LABEL "Status"
  POSITION 8
  MAX-WIDTH 40
  ORDER 70
  MANDATORY

ADD FIELD "Verdict" OF "Payout" AS character
  FORMAT "x(30)"
  INITIAL ""
  LABEL "Rule verdict"
  POSITION 9
  MAX-WIDTH 60
  ORDER 80

ADD FIELD "RejectReasons" OF "Payout" AS character
  FORMAT "x(2000)"
  INITIAL ""
  LABEL "Reject reasons (JSON)"
  POSITION 10
  MAX-WIDTH 4000
  ORDER 90

ADD FIELD "CreatedAt" OF "Payout" AS datetime-tz
  FORMAT "99/99/9999 HH:MM:SS.SSS+HH:MM"
  INITIAL "?"
  LABEL "Created at"
  POSITION 11
  MAX-WIDTH 8
  ORDER 100
  MANDATORY

ADD FIELD "DecidedAt" OF "Payout" AS datetime-tz
  FORMAT "99/99/9999 HH:MM:SS.SSS+HH:MM"
  INITIAL "?"
  LABEL "Decided at"
  POSITION 12
  MAX-WIDTH 8
  ORDER 110

ADD FIELD "RequestId" OF "Payout" AS character
  FORMAT "x(40)"
  INITIAL ""
  LABEL "Request Id"
  POSITION 13
  MAX-WIDTH 80
  ORDER 120

ADD INDEX "PayoutId" ON "Payout"
  AREA "Schema Area"
  UNIQUE
  PRIMARY
  INDEX-FIELD "PayoutId" ASCENDING

ADD INDEX "LotMemberPayout" ON "Payout"
  AREA "Schema Area"
  INDEX-FIELD "LotId" ASCENDING
  INDEX-FIELD "MemberId" ASCENDING
  INDEX-FIELD "PayoutStatus" ASCENDING

ADD INDEX "MemberPayout" ON "Payout"
  AREA "Schema Area"
  INDEX-FIELD "MemberId" ASCENDING
  INDEX-FIELD "PayoutStatus" ASCENDING

.
