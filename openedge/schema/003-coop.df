  MAX-WIDTH 4000
  ORDER 80

ADD FIELD "CreatedAt" OF "Allocation" AS datetime-tz
  FORMAT "99/99/9999 HH:MM:SS.SSS+HH:MM"
  INITIAL "?"
  LABEL "Created at"
  POSITION 10
  MAX-WIDTH 8
  ORDER 90
  MANDATORY

ADD FIELD "DecidedAt" OF "Allocation" AS datetime-tz
  FORMAT "99/99/9999 HH:MM:SS.SSS+HH:MM"
  INITIAL "?"
  LABEL "Decided at"
  POSITION 11
  MAX-WIDTH 8
  ORDER 100

ADD FIELD "DeliveredAt" OF "Allocation" AS datetime-tz
  FORMAT "99/99/9999 HH:MM:SS.SSS+HH:MM"
