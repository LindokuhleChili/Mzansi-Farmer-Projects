# Copy to .env (or run `npm run setup`, which also generates random tokens). Never commit .env.
PORT=3000
HOST=0.0.0.0

# OpenEdge: mock = Node port of the ABL rules (runs anywhere); pasoe = real PAS for OpenEdge REST service
OE_MODE=mock
OE_BASE_URL=http://localhost:8820/web
# PASOE basic login (openedge/pasoe/README.md), as user:password. Real passwords go ONLY in your local .env.
#   OE_AUTH       = PSCUser (farmapi): every normal call from the Node API
#   OE_ADMIN_AUTH = PSCUser + PSCAdmin (farmadmin): blocked-terms and alert-threshold changes
#   OE_NONE_AUTH  = ROLE_None (farmnone): only used by the 403 test, eval/pasoe-security.mjs
# Leave empty when PASOE runs with the anonymous login model.
OE_AUTH=
OE_ADMIN_AUTH=
OE_NONE_AUTH=

# Token the app / farmer uses (Authorization: Bearer ...)
APP_TOKEN=replace-with-random-string
# Sensor devices: token maps to a deviceId and its plot (JSON array)
DEVICE_REGISTRY=[{"deviceId":"esp32-01","plotId":1,"token":"replace-with-random-device-token"}]

# AI provider: mock = deterministic, no key needed. http = any OpenAI-compatible /chat/completions API
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Example (Google Gemini, OpenAI-compatible endpoint). Put the real key ONLY in your local .env, never in git:
#   AI_PROVIDER=http
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-3.5-flash-lite
#   AI_API_KEY=<your key>
# Max wait for one translation batch (ms). Advice keeps its own 8 s limit.
AI_TRANSLATE_TIMEOUT_MS=20000
# Plant doctor: photos take longer than text, so it has its own timeout (ms).
AI_DOCTOR_TIMEOUT_MS=30000
# mock only: normal | timeout | bad-json | injection | extra-field | greedy | invented-number | hold-with-litres | notify-no-litres
AI_MOCK_BEHAVIOUR=normal

LOG_DIR=logs
LOG_LEVEL=warn

# Weather alerts: real 7-day forecast from Open-Meteo (no key, CC BY 4.0). 'example' keeps the offline example forecast only.
WEATHER_SOURCE=open-meteo
WEATHER_TIMEOUT_MS=8000
